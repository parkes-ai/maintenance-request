{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(admin|login|signup|my)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/r/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cleanup",
      "schedule": "0 19 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/r/:token",
      "destination": "/index.html"
    }
  ]
}
